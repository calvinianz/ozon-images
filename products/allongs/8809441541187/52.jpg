#loyaltyRewardPointsEarningsFeature .shimmer-earningsMobileRewardIconContainer{position:relative;display:inline-block;overflow:hidden;width:2.25rem;height:2rem;margin-right:-.35rem;vertical-align:sub}#loyaltyRewardPointsEarningsFeature .shimmer-earningsMobileRewardIconContainer.shimmer-active::after{content:'';position:absolute;top:-70%;right:-70%;width:240%;height:240%;pointer-events:none;background:linear-gradient(90deg,rgba(255,255,255,0) 26%,rgba(255,255,255,.22) 42%,rgba(255,255,255,.7) 50%,rgba(255,255,255,.22) 58%,rgba(255,255,255,0) 74%);mix-blend-mode:overlay;transform-origin:50% 50%;transform:rotate(-40.5deg) translateX(65%);animation:shine 2.5s ease-in-out 2 forwards}@keyframes shine{to{transform:rotate(-40.5deg) translateX(-65%)}}#loyaltyRewardPointsEarningsFeature .earningsMainHeading{font-size:1.5rem}#loyaltyRewardPointsEarningsFeature .dynamicDiamondsInfo,#loyaltyRewardPointsEarningsFeature .dynamicDiamondsInfo:active,#loyaltyRewardPointsEarningsFeature .dynamicDiamondsInfo:hover,#loyaltyRewardPointsEarningsFeature .dynamicDiamondsInfo:link,#loyaltyRewardPointsEarningsFeature .dynamicDiamondsInfo:visited{color:#000;text-decoration:none}#loyaltyRewardPointsEarningsFeature .earningsIconContainer{height:1.8rem;margin-top:.1rem;margin-right:.2rem}#loyaltyRewardPointsEarningsFeature .earningsDetailsChevronIcon{position:absolute;right:0;margin-top:1.5rem}#loyaltyRewardPointsEarningsFeature .offerEndMessageContainer{background-color:#007185;color:#fff;padding:4px 8px 4px 8px;margin-top:6px;display:inline-block;font-size:13px;font-weight:400;border-radius:.4rem}#loyaltyRewardPointsEarningsFeature .offerEndMessageContainerWithWhiteBg{background-color:#fff;color:#696969;padding:4px 8px 4px 0;margin-top:6px;display:inline-block;font-size:13px;font-weight:400;border-radius:.4rem}#earnings-widget .earnings-sheet-content{margin:2rem 1.5rem 3rem}#earnings-widget .earningsPointsBalanceContainer{background-color:#F0F2F2;font-size:1.5rem;display:inline-block;padding:.8