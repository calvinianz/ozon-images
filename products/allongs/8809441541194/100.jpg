#mbiv-vertical{height:100vh;background:#fff;width:100vw}.pageBodyMbiv{overflow:hidden!important}.mbiv-img-wrapper{display:flex;justify-content:center;margin:0 8px 8px 8px;background-color:#fff}.mbiv-img{width:100vw;object-fit:contain}.img-peekview-80{max-height:calc(80vh - 80px)}.img-peekview-90{max-height:calc(90vh - 90px)}.mbiv-media-element{margin:0}#mbiv-header{width:100vw;background:#fff;display:flex;justify-content:space-between;align-items:flex-end;margin-bottom:2px;height:100px;box-shadow:0 2px 5px rgba(15,17,17,.15)}.mbivHeaderNotchPadding{padding-top:60px!important}.mbivHeaderHeight{height:80px!important}#mbiv-title{text-align:left}.mbiv-media{overflow-y:scroll;height:calc(100dvh - 80px);padding-bottom:30px;background:#d5d9d9}#mbiv-close-action{justify-content:center;align-items:center;display:flex;right:0;padding-bottom:.4rem}.mbiv-single-media{display:flex;justify-content:center;align-items:center;background:#fff!important}#mbiv-vertical.mb-vertical-iv-cardified{background:#fff}#mbiv-vertical.mb-vertical-iv-cardified .mbiv-media{background-color:unset;padding-left:12px;padding-right:12px;padding-top:12px;padding-bottom:50px}#mbiv-vertical.mb-vertical-iv-cardified ul{overscroll-behavior-y:contain}#mbiv-vertical.mb-vertical-iv-cardified li{padding:16px 24px;border-radius:8px;min-height:unset;margin-bottom:12px}#mbiv-vertical.mb-vertical-iv-cardified li[data-csa-c-media-type=BOOK_DESCRIPTION_SUMMARY],#mbiv-vertical.mb-vertical-iv-cardified li[data-csa-c-media-type=BOOK_EDITORIAL_REVIEW],#mbiv-vertical.mb-vertical-iv-cardified li[data-csa-c-media-type=BOOK_POPULAR_HIGHLIGHT]{padding:24px}#mbiv-vertical.mb-vertical-iv-cardified li:first-child{background:unset;padding:unset}#mbiv-vertical.mb-vertical-iv-cardified li[data-csa-c-media-type=IMAGE]:not(:first-child){overflow:visible;z-index:1;background:#f7f7f7}#mbiv-vertical.mb-vertical-iv-cardified li[data-csa-c-media-type=IMAGE]:not(:first-child) .mbiv-img-wrapper{position:relative;z-index:2}#mbiv-vertical.mb-vertical-iv-cardified .mbiv-img-wrapper{margin:unset!important}body:has(.mb-vertical-iv-cardified) #zoomable-clone img{height:auto!important}