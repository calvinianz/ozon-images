#multi-selection-experience{position:fixed;width:100%;bottom:0;z-index:299;margin:0;background-color:#f9fbfb;border-width:0;height:100vh;right:0!important;transition:.5s}.msx-selection-summary{background-color:#F9F9F9;box-shadow:-3px 0 6px rgba(0,0,0,.25);position:sticky;padding:18px 14px 16px 14px}.msx-item-count{line-height:20px!important;font-size:15px}#multi-select-experience-scroller{overflow-x:hidden!important;background:#F7FAFA!important}.msx-subtotal-heading{display:inline;font-size:15px;line-height:20px}.msx-total-price{font-weight:700;font-size:16px!important;line-height:24px!important}.msx-select-items-msg{margin-top:5px;margin-bottom:12px}.msx-atc-generic-btn-mobile{height:45px}.msx-selection-summary-and-atc-warning-msg{position:sticky;position:-webkit-sticky;top:0;z-index:100000000;background:#fff;margin-bottom:0!important}.msx-atc-alert-msg{background-color:#FFF}.msx-atc-warning{position:absolute;width:100%}.msx-atc-warning-msg-box{margin-top:10px;margin-left:14px;margin-right:14px}.msx-overview-and-dimension-tree-container{background-color:#fff;box-shadow:-3px 0 6px rgba(0,0,0,.25);mix-blend-mode:normal}.msx-overview{padding-top:16px;padding-left:14px;padding-right:14px;margin-bottom:22px}.msx-dimension-tree-indentation{position:relative}.msx-dimension-tree-indentation .a-section-expander-container{overflow:visible}.msx-dimension-details{display:flex}.msx-dimension-image-box{margin-right:8px;background:rgba(255,255,255,.05);border:1px solid #989CA2;border-radius:2px}.msx-dimension-image{position:absolute}.msx-asin-has-image{margin-right:0!important}.msx-asin-has-no-image{width:100%!important}.msx-asin-variation-row .msx-asin-variation-price-details{padding-right:8px}.msx-current-dimension-total-col{padding-top:14px;text-align:right;float:right!important}.msx-current-dimension-total-price{font-size:14px!important}.msx-current-dimension-totalunits-selected{font-size:12px;padding-top:14px;padding-left:8px;white-space:nowrap}.msx-dimension-list-divider{border-top-color:#D5D9D9}.msx-dimension-list{margin-left:14px;margin-right:14px}.msx-dimension-content-section{display:flex;align-items:center}.msx-dimension-content{min-height:50px}.msx-asin-image-col{margin-right:0!important;width:57px!important}.msx-asin-title-row{margin-top:8px;margin-left:8px;margin-bottom:8px}.msx-asin-title{display:-webkit-box;display:-moz-box;-webkit-line-clamp:1;-webkit-box-orient:vertical;text-overflow:ellipsis;overflow:hidden;white-space:normal}.msx-qty-picker-col{margin-left:8px;margin-bottom:20px}.msx-asin-variation-col{margin-right:0!important;float:right!important}.msx-qty-picker-input{float:left;width:55px;font-size:15px}input[id^="msx-qty-picker-id:"]{-moz-appearance:textfield}input[id^="msx-qty-picker-id:"]::-webkit-inner-spin-button,input[id^="msx-qty-picker-id:"]::-webkit-outer-spin-button{-webkit-appearance:none;margin:0}.msx-asin-price{display:flex;justify-content:flex-end}.msx-asin-tax-exclusive-text{float:right;text-align:right}.msx-asin-ppu-text{float:right}.msx-asin-qty-unavailable{float:right;margin-top:5px}.msx-child-variation-box{background:#FFF;border:1px solid #E6E5E5;border-radius:3px;cursor:default}.msx-child-variation-box .a-box-inner{padding:0}.msx-dimension-divider{border-top-color:#D5D9D9}.msx-child-variation-divider{border-top-color:#D5D9D9}.msx-child-variation-indentation{position:relative}.msx-dimension-indentation{position:relative;margin-left:8px}.msx-expanded-dimension-content{padding-left:0!important}.msx-margin-top-12{margin-top:12px}.msx-margin-top-8{margin-top:8px}.msx-display-other-child-variations{margin-top:12px}.msx-display-other-dimensions{margin-top:12px}hr[class*=msx-see-all-options-dimension-divider]{border-top-color:#D5D9D9}.msx-hidden{visibility:hidden}.msx-quantity-unavailable-container{width:180px;z-index:100!important;position:absolute;background:#fff;padding:14px 18px 18px 18px!important;border:1.17px solid #CCC;box-shadow:0 4px 14px rgba(0,0,0,.1);border-radius:4px;text-align:center;transform:translateY(43px)}.msx-qty-picker-container{width:180px;z-index:100!important;position:absolute;background:#fff;border:1.17px solid #CCC;box-shadow:0 4px 14px rgba(0,0,0,.1);border-radius:4px;text-align:left;transform:translateY(43px)}.msx-qty-picker-container-override{width:230px}.msx-qty-picker-dropup{transform:translateY(calc(-100% + 1px))}.msx-qpt-ul{margin-left:0}.msx-qty-picker-dropdown-item{display:block;border:1px solid #BCC0C3;border-top:none}.msx-qty-picker-dropdown-item:hover{background-color:#F4F4F5;cursor:pointer}.msx-qty-picker-dropdown-item-active{border-color:#BCC0C3;border-left:3px solid #C7511F;font-weight:700}.msx-qty-picker-load-more{color:#696969;font-size:12px;vertical-align:middle;text-align:center;padding:10.5px 8px 10.5px 9px}.msx-qty-picker-spinner-wrapper{margin:0 auto;display:table-cell;vertical-align:middle;text-align:center;padding:14px!important}.msx-qty-picker-option{display:table;width:100%}.msx-qty-picker-option-tier{vertical-align:middle;display:table-cell;color:inherit;width:5%;padding-left:10px;padding-right:10px;text-align:left;line-height:40px;font-size:15px}.msx-qty-picker-option-price-msg{vertical-align:middle;color:inherit;display:table-cell;width:95%;padding-right:10px;float:right;text-align:right;margin-top:7px;margin-bottom:7px}.msx-qty-picker-option-price{color:inherit;font-size:13px;margin-left:-10px;line-height:15px}.msx-qty-picker-option-price-break-word{word-break:break-word}.msx-qty-picker-option-savings-msg{font-size:12px;line-height:15px;font-style:italic;font-weight:400;margin-left:-30px}.msx-slot-data-1{margin-top:-30px}.msx-slot-data-2{margin-top:-30px}